rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email in ['admin@rrreparacao.com.br'];
    }

    function isWorkspaceOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isWorkspaceActive(userId) {
      let workspacePath = /databases/$(database)/documents/workspaces/$(userId);
      return exists(workspacePath)
        && (!('accessStatus' in get(workspacePath).data) || get(workspacePath).data.accessStatus == 'active');
    }

    match /workspaces/{userId} {
      allow read: if isWorkspaceOwner(userId) || isAdmin();

      allow create: if isWorkspaceOwner(userId)
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.accessStatus == 'pending';

      allow update: if isWorkspaceOwner(userId)
        && isWorkspaceActive(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['owner', 'ownerUid', 'accessStatus', 'subscription', 'subscriptionUpdatedAt']);

      allow delete: if isAdmin();
      allow create, update: if isAdmin();
    }

    match /workspaces/{userId}/{subcollection}/{documentId} {
      allow read, create, update, delete: if isAdmin()
        || (isWorkspaceOwner(userId) && isWorkspaceActive(userId));
    }

    match /public_orcamentos/{shareId} {
      // O endereço aleatório funciona como link de visualização para o cliente.
      allow read: if true;

      allow create: if isAdmin()
        || (isSignedIn()
          && request.resource.data.owner == request.auth.uid
          && request.resource.data.ownerUid == request.auth.uid
          && isWorkspaceActive(request.auth.uid));

      allow update: if (isSignedIn() && resource.data.ownerUid == request.auth.uid)
        || (request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['clientResponse', 'clientRespondedAt'])
          && (!('clientResponse' in request.resource.data)
            || request.resource.data.clientResponse in ['approved', 'rejected']));

      allow delete: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
